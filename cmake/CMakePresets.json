{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 (MSVC)",
      "description": "x64 build with the Visual Studio 2026 MSVC toolset (v145).",
